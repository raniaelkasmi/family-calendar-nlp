# Copy to supabase/functions/.env (git-ignored). Used by `npm run eval` only.
# In production the key lives in Supabase secrets:
#   npx supabase secrets set GEMINI_API_KEY=...
GEMINI_API_KEY=
# Optional: override the model (default gemini-flash-lite-latest), e.g. to compare in the eval.
# GEMINI_MODEL=gemini-flash-latest
